# Copy this file to .env and fill in what you have. Everything is optional
# for local testing; features switch on as keys are added.

# Public web address, used in emails and Stripe return links.
SITE_URL=http://localhost:3000

# Where the database and uploaded files live. Point this at a persistent disk in production.
DATA_DIR=./data

# --- Online deposits (Stripe) ---
# Without these, bookings show "pay at drop-off" and staff mark payments by hand.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (any SMTP provider: Google Workspace, SendGrid, Mailgun...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hot Diggity Dog Resort <info@hotdiggitydogresort.com>"
# Staff inbox that receives new-booking alerts.
STAFF_EMAIL=

# --- Text messages (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
